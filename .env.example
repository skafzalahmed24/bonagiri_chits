# Bonagiri Chits backend: environment variables.
# Copy this file to `.env` and fill in the real values. Never commit `.env` (it is git-ignored) and
# never put real secrets in this file: it only lists the names and safe placeholders.

# ---- Server ---------------------------------------------------------------------------------
# Use `production` on the live server, `development` on dev and staging.
NODE_ENV=development
PORT=5002
# Public base URL used to build links to uploaded files (optional; derived from the request when empty).
FILE_BASE_URL=

# ---- Database (PostgreSQL) ------------------------------------------------------------------
DB_HOST=localhost
DB_DIALECT=postgres
DB_DATABASE=bonagiri_chits
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Connection pool size (optional, default 20).
DB_POOL_MAX=20

# ---- Auth -----------------------------------------------------------------------------------
# Static key the apps and web send on public routes (login, OTP, app-version check).
DEFAULT_API_TOKEN=change-me
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Optional, default 1y. Examples: 15m, 12h, 7d, 1y.
JWT_EXPIRES_IN=1y
JWT_REFRESH_EXPIRES_IN=1y
# Super Admin login. The password is stored as a hash, never in plain text.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD_HASH=change-me

# ---- Dev and staging only: Business Date tools ----------------------------------------------
# Super Admin > System Utilities lets a Super Admin move the "Business Date" (what the whole system treats as
# today), switch the scheduler to manual and run the penalty and group-status jobs by hand. It exists only to
# test date-driven behaviour (due dates, penalties, auction status) on dev and staging without waiting for real days.
# On a live server it would be dangerous: a saved test date would change dues, penalties and group status for
# real customers, and the apps read the same date. So this one switch controls it:
#   true  -> tools available (dev, staging)
#   false -> tools completely hidden: the screen is gone, the routes answer 404, and any Business Date saved
#            earlier is ignored (the real India date is always used)
# If this is left empty, the tools are on unless NODE_ENV=production, so a forgotten setting cannot expose them
# on a production server. PRODUCTION MUST SET THIS TO false (and NODE_ENV=production).
ENABLE_BUSINESS_DATE_TOOLS=true

# ---- SMS / OTP (Twilio) ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_API_KEY_SID=change-me
TWILIO_API_SECRET=change-me
TWILIO_VERIFY_SERVICE_SID=change-me
TWILIO_PHONE_NUMBER=change-me
# `true` = every OTP is the fixed test code 123456 and no SMS is sent (dev and staging only).
# `false` = real OTPs through Twilio (production).
STATIC_OTP_STATUS=false

# ---- Push notifications (Firebase Cloud Messaging) ------------------------------------------
FCM_PROJECT_ID=change-me
FCM_CLIENT_EMAIL=change-me
# Keep the \n line breaks inside the quotes.
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----\n"
# iOS bundle id used as the APNs topic (optional, default com.bonagiriChits.app).
APNS_BUNDLE_ID=com.bonagiriChits.app
